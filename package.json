{
    "name": "playwright_automation",
    "version": "2.0.0",
    "description": "Web automation project with playwright",
    "main": "index.ts",
    "scripts": {
        "format": "prettier --write .",
        "pretest": "eslint .",
        "lint:fix": "eslint . --fix",
        "test:ui-headed": "npx playwright test --project=ui_test --headed --grep \"@ui\"",
        "test:ui": "npx playwright test --project=ui_test --grep \"@ui\"",
        "test:api": "npx playwright test --project=api_test --grep \"@api\"",
        "test:report": "npx allure generate ./allure-results",
        "report:open": "npx allure open ./allure-report",
        "docker:build": "docker build -t playwright-automation .",
        "docker:test": "docker compose run --rm tests",
        "docker:report": "docker compose run --rm report",
        "docker:serve": "docker compose up -d serve",
        "docker:down": "docker compose down",
        "docker:execution": "npm run docker:down && npm run docker:test && npm run docker:report && npm run docker:serve"
    },
    "keywords": [
        "playwright",
        "typescript",
        "automation"
    ],
    "author": "Jonathan Fernández",
    "license": "ISC",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@faker-js/faker": "^9.5.0",
        "@playwright/test": "^1.59.1",
        "@types/node": "^22.12.0",
        "@typescript-eslint/eslint-plugin": "^8.59.1",
        "@typescript-eslint/parser": "^8.59.1",
        "allure": "^3.6.0",
        "allure-commandline": "^2.38.1",
        "allure-playwright": "^3.7.1",
        "dotenv": "^16.4.7",
        "eslint": "^10.2.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-playwright": "^2.10.2",
        "eslint-plugin-prettier": "^5.5.5",
        "globals": "^17.6.0",
        "prettier": "^3.8.3",
        "typescript": "^5.9.3"
    }
}
